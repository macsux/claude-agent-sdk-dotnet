<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package Info -->
    <PackageId>Claude.AgentSdk</PackageId>
    <Version>0.2.152</Version>
    <AssemblyVersion>0.2.82.0</AssemblyVersion>
    <FileVersion>0.2.82.0</FileVersion>
    <Authors>Elias Bachaalany</Authors>
    <Company>0xeb</Company>
    <Product>Claude Agent SDK</Product>
    <Description>A .NET SDK for interacting with Claude Code CLI. Provides simple QueryAsync() API, bidirectional client, hooks, tool permissions, and in-process MCP server support.</Description>
    <PackageTags>claude;anthropic;ai;agent;sdk;llm;mcp;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/0xeb/claude-agent-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0xeb/claude-agent-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2025 Elias Bachaalany</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Parity with Python claude-agent-sdk v0.2.82 (Phase 6B): SessionStore + conformance harness, materialized resume, context-usage / MCP-status surfaces, v0.2.82 message parser additions, new examples (SessionStores, SessionStoreUsage, SessionResume, ContextUsage, HookEvents).</PackageReleaseNotes>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic Builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- AOT/Trimming -->
    <!-- Enables the trim, single-file and AOT analyzers; the build must stay free of IL2xxx/IL3xxx warnings.
         Reflection-only APIs (McpSdkServerBuilder.Tool(string, Delegate, ...)) are annotated and have AOT-safe
         alternatives. tests/Claude.AgentSdk.AotSmoke publishes a NativeAOT app against this library. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- SourceLink for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Include README in package -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <!-- ILogger integration (ClaudeAgentOptions.Logger). Abstractions only: trim/AOT-safe, no providers. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
